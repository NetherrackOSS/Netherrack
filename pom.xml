<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.netherrack</groupId>
    <artifactId>netherrack-server</artifactId>
    <version>0.2.0-alpha</version>
    <packaging>jar</packaging>

    <name>Netherrack</name>
    <description>A from-scratch Minecraft Bedrock server software</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- CloudburstMC libraries used for the RakNet transport + Bedrock protocol layer.
             Credit: https://github.com/CloudburstMC/Network and https://github.com/CloudburstMC/Protocol
             Both are only published as snapshots right now (see the opencollab-snapshots
             repository below) — their git release tags don't correspond to published
             Maven artifacts. -->
        <cloudburst.network.version>1.0.0.CR3-SNAPSHOT</cloudburst.network.version>
        <cloudburst.protocol.version>3.0.0.Beta13-SNAPSHOT</cloudburst.protocol.version>
    </properties>

    <!-- CloudburstMC's own repository. Despite what the READMEs imply, the release artifacts
         (Network) and the current snapshot artifacts (Protocol, on the 3.0 branch) both live
         here rather than on Maven Central. -->
    <repositories>
        <repository>
            <id>opencollab-releases</id>
            <url>https://repo.opencollab.dev/maven-releases/</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>opencollab-snapshots</id>
            <url>https://repo.opencollab.dev/maven-snapshots/</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <dependencies>
        <!-- RakNet transport (Netty-based). -->
        <dependency>
            <groupId>org.cloudburstmc.netty</groupId>
            <artifactId>netty-transport-raknet</artifactId>
            <version>${cloudburst.network.version}</version>
        </dependency>

        <!-- Bedrock packet codec + connection handling. Snapshot-only for now. -->
        <dependency>
            <groupId>org.cloudburstmc.protocol</groupId>
            <artifactId>bedrock-codec</artifactId>
            <version>${cloudburst.protocol.version}</version>
        </dependency>
        <dependency>
            <groupId>org.cloudburstmc.protocol</groupId>
            <artifactId>bedrock-connection</artifactId>
            <version>${cloudburst.protocol.version}</version>
        </dependency>

        <!-- Enables ANSI color processing on Windows consoles (cmd.exe/PowerShell), which
             don't interpret ANSI escape codes by default the way Linux/macOS terminals do.
             jline-terminal-jni is JLine's own native provider (since 3.24.0, no external
             Jansi/JNA dependency needed) - the same fix CloudburstMC's own server software
             uses for this. FFM would be the newer alternative but requires Java 21+; this
             project targets 17, so JNI is the right one here. -->
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline-terminal</artifactId>
            <version>3.29.0</version>
        </dependency>
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline-terminal-jni</artifactId>
            <version>3.29.0</version>
        </dependency>
        <!-- JLine's line reader (BSD-3-Clause, like the rest of JLine) for the console prompt:
             it reads keys itself, so it knows what's been typed and can draw it again below
             log lines printed while a command is being typed. -->
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline-reader</artifactId>
            <version>3.29.0</version>
        </dependency>

        <!-- World storage: Bedrock worlds keep their chunks in a LevelDB database, in Mojang's
             variant that compresses with zlib instead of Snappy. This is a pure Java LevelDB
             with Mojang's changes (Apache 2.0): https://github.com/HiveGamesOSS/leveldb-mcpe-java
             Its published POM leaves out its own API module and Guava (both are only in its
             "uber" jar, alongside Snappy's native libraries we don't need), so they're
             declared here. Guava is Apache 2.0 too. -->
        <dependency>
            <groupId>com.hivemc.leveldb</groupId>
            <artifactId>leveldb</artifactId>
            <version>1.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.hivemc.leveldb</groupId>
            <artifactId>leveldb-api</artifactId>
            <version>1.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.4.8-jre</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>netherrack-${project.version}</finalName>
        <resources>
            <!-- Only version.properties is filtered (its ${project.version} is replaced with the
                 version above, which is where VersionInfo reads it from). Everything else is
                 copied as it is - filtering would corrupt the binary .nbt data files. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>version.properties</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>version.properties</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <!-- Writes the short id of the git commit being built into git.properties, which
                 VersionInfo reads for /version. Only that one property is kept: by default the
                 file also holds the committer's name and email and the remote's URL, which
                 shouldn't end up inside a jar that gets shared. Building outside a git checkout
                 (a downloaded source archive, say) is fine - nothing is written, and the commit
                 shows as "unknown". -->
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
                <version>8.0.2</version>
                <executions>
                    <execution>
                        <id>get-the-git-infos</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>revision</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <generateGitPropertiesFile>true</generateGitPropertiesFile>
                    <generateGitPropertiesFilename>${project.build.outputDirectory}/git.properties</generateGitPropertiesFilename>
                    <failOnNoGitDirectory>false</failOnNoGitDirectory>
                    <failOnUnableToExtractRepoInfo>false</failOnUnableToExtractRepoInfo>
                    <includeOnlyProperties>
                        <includeOnlyProperty>^git\.commit\.id\.abbrev$</includeOnlyProperty>
                    </includeOnlyProperties>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.netherrack.server.Netherrack</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <!-- Shades the CloudburstMC libraries (and their dependencies) into the final jar
                 so "java -jar" works standalone. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.netherrack.server.Netherrack</mainClass>
                                </transformer>
                                <!-- JLine discovers its terminal providers (including jline-terminal-jni)
                                     via META-INF/services; without merging these across jars, shading
                                     could silently drop the JNI provider's registration. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
